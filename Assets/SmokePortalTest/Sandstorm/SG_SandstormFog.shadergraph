{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "486e5b4ea575456c9862dbc06a143901",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "SandstormNoise (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -450.0,
            "y": 0.0,
            "width": 200.0,
            "height": 40.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "1e52c179e44e4c97881cfeafa6151806"
        },
        {
            "m_Id": "3c1395529d444478b361985dd82cf63b"
        },
        {
            "m_Id": "5f09bc944b1440e79572338bc6f95e54"
        },
        {
            "m_Id": "11171c533b7540e4ba996a7125eb7018"
        },
        {
            "m_Id": "126ecc48682f4ad39798f4cc8a836de6"
        },
        {
            "m_Id": "9607375673ef415a9fa401562c1eb6e1"
        },
        {
            "m_Id": "d23c16b11b0b45669bb6e02a192b2d4d"
        },
        {
            "m_Id": "ac435eda1af743a6abeeba3ab9d9caf4"
        }
    ],
    "synonyms": [],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "SandstormNoise",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// 3D Perlin (gradient) noise fBm, same family as Blender's Noise Texture\nfloat3 p = UV * NoiseScale + Offset;\nfloat sum = 0.0;\nfloat amp = 1.0;\nfloat norm = 0.0;\n[unroll] for (int o = 0; o < 6; o++)\n{\n    float3 i = floor(p);\n    float3 f = frac(p);\n    float3 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);\n    float n[8];\n    [unroll] for (int c = 0; c < 8; c++)\n    {\n        float3 corner = float3(c & 1, (c >> 1) & 1, (c >> 2) & 1);\n        float3 h = frac((i + corner) * float3(0.1031, 0.1030, 0.0973));\n        h += dot(h, h.yxz + 33.33);\n        float3 g = frac((h.xxy + h.yxx) * h.zyx) * 2.0 - 1.0;\n        n[c] = dot(g, f - corner);\n    }\n    float v = lerp(lerp(lerp(n[0], n[1], u.x), lerp(n[2], n[3], u.x), u.y),\n                   lerp(lerp(n[4], n[5], u.x), lerp(n[6], n[7], u.x), u.y), u.z);\n    sum += v * amp;\n    norm += amp;\n    amp *= Roughness;\n    p = p * 2.0 + 17.13;\n}\nfloat noise = 0.5 + 0.5 * (sum / norm) * 1.5;\nOut = smoothstep(RampMin, RampMax, noise) * Density;"
}

{

# Normalize text consistently across operating systems
* text=auto
# Project text files
.gitattributes text eol=lf
.gitignore text eol=lf
*.cs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
# Unity YAML files
*.anim text eol=lf merge=unityyamlmerge
*.asset text eol=lf merge=unityyamlmerge
*.controller text eol=lf merge=unityyamlmerge
*.mat text eol=lf merge=unityyamlmerge
*.meta text eol=lf merge=unityyamlmerge
*.prefab text eol=lf merge=unityyamlmerge
*.unity text eol=lf merge=unityyamlmerge
# Binary assets
*.aif -text
*.aiff -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.exr -text
*.fbx -text
*.flac -text
*.gif -text
*.glb -text
*.hdr -text
*.jpeg -text
*.jpg -text
*.mp3 -text
*.mp4 -text
*.ogg -text
*.otf -text
*.pdf -text
*.png -text
*.psd -text
*.tga -text
*.tif -text
*.tiff -text
*.ttf -text
*.wav -text
*.zip -text
